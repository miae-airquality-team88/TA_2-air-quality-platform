{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sensor_message.json",
  "title": "Message capteur qualité de l'air",
  "description": "Contrat v1.0 des messages publiés dans le topic Kafka raw_data. Voir schemas/README.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sensor_id", "timestamp", "location", "measurements", "status", "source"],
  "properties": {
    "sensor_id": {
      "type": "string",
      "pattern": "^(CAP_[0-9]{3}|OPENAQ_[0-9]+)$",
      "description": "CAP_001... pour les capteurs simulés, OPENAQ_<id> pour la station réelle"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "Horodatage ISO 8601 en UTC, ex. 2026-11-02T14:30:00Z"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pm2_5", "pm10", "no2", "o3", "temperature", "humidity"],
      "properties": {
        "pm2_5": {"type": ["number", "null"], "description": "Particules fines PM2.5, µg/m³"},
        "pm10": {"type": ["number", "null"], "description": "Particules PM10, µg/m³"},
        "no2": {"type": ["number", "null"], "description": "Dioxyde d'azote, µg/m³"},
        "o3": {"type": ["number", "null"], "description": "Ozone, µg/m³"},
        "temperature": {"type": ["number", "null"], "description": "Température, °C"},
        "humidity": {"type": ["number", "null"], "description": "Humidité relative, %"}
      }
    },
    "status": {"enum": ["active", "inactive", "maintenance"]},
    "source": {"enum": ["simulator", "openaq"]},
    "injected_anomaly": {
      "enum": [null, "spike", "negative", "out_of_range", "stuck", "missing_values"],
      "description": "Anomalie injectée volontairement par le simulateur (vérité terrain pour le ML), null sinon"
    }
  }
}
