# =============================================================
#  Modèle de configuration - à copier en ".env" (jamais commité)
#  Commande (Anaconda Prompt) : copy .env.example .env
# =============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_USER=airquality
POSTGRES_PASSWORD=change_moi
POSTGRES_DB=airquality
# Port côté Windows (5433 pour ne pas entrer en conflit avec un PostgreSQL déjà installé)
POSTGRES_PORT=5433

# --- Kafka ---
# Depuis Windows (scripts Python) : localhost:9092
# Depuis un autre conteneur Docker : kafka:29092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenAQ ---
# Clé gratuite à créer sur https://explore.openaq.org (compte -> API Key)
OPENAQ_API_KEY=
OPENAQ_LOCATION_ID=3847229
